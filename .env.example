# Supabase project settings (Project Settings -> API). Never commit real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Security check script (`npm run security-check`). Dedicated check accounts only; anon key only,
# never a service_role key. URL / anon key fall back to the VITE_* values above when left empty.
# Local stack: see README "Проверка безопасности" (supabase/local/check-users.sql).
CHECK_SUPABASE_URL=
CHECK_SUPABASE_ANON_KEY=
CHECK_MANAGER_EMAIL=
CHECK_MANAGER_PASSWORD=
CHECK_MANAGER2_EMAIL=
CHECK_MANAGER2_PASSWORD=
CHECK_EXECUTOR_A_EMAIL=
CHECK_EXECUTOR_A_PASSWORD=
CHECK_EXECUTOR_B_EMAIL=
CHECK_EXECUTOR_B_PASSWORD=
